---
config:
  layout: elk
---
flowchart TB
  subgraph region_harness["Evaluation harness"]
    harness["Evaluation harness<br/>每 sample 一个实例"]:::entry
    question["QA question<br/>category + reference"]:::entry
    query["generate_query_llm<br/>question → keywords"]:::process
    prompt["answer_question<br/>构造 QA context"]:::process
    output["Prediction + metrics<br/>日志与结果 JSON"]:::output
  end
  subgraph region_native["Robust memory layer"]
    add["add_note<br/>同步写入入口"]:::process
    construct["RobustMemoryNote<br/>构造与 metadata"]:::process
    evolve["process_memory<br/>决策与条件演化"]:::process
    notes[("memories<br/>UUID → MemoryNote")]:::store
    index[("SimpleEmbeddingRetriever<br/>corpus + embeddings")]:::store
    gate{"evo_cnt % threshold<br/>默认每 100 次演化"}:::decision
    rebuild["consolidate_memories<br/>全量重建索引"]:::process
    expand["find_related_memories_raw<br/>top-k + 单跳链接"]:::process
  end
  subgraph region_models["模型执行边界"]
    controller["RobustLLMController<br/>同步模型调用"]:::process
  end
  subgraph region_disk["Harness 本地派生文件"]
  end
  harness -->|"Speaker + turn.text；session 时间"| add
  add -->|"创建 UUID note"| construct
  construct -->|"metadata 分析；异常 heuristic"| controller
  construct -->|"已构造 note"| evolve
  evolve -->|"content cosine search，k=5"| index
  evolve -->|"顺序 decision / strengthen / update"| controller
  evolve -->|"邻居原位更新；新 note 保存"| notes
  notes -->|"追加新 note 拼接文档"| index
  evolve -->|"True 时 evo_cnt += 1"| gate
  gate -->|"每 threshold 次演化触发"| rebuild
  notes -->|"读取当前所有 note metadata"| rebuild
  rebuild -->|"替换 corpus 和 embeddings"| index
  question -->|"原始 question"| query
  query -->|"请求关键词字符串"| controller
  query -->|"keywords，k=retrieve_k"| expand
  index -->|"cosine top-k 行号"| expand
  notes -->|"按行号取正文 + 跟 links"| expand
  expand -->|"raw_context，无二次筛选"| prompt
  question -->|"category；C5 候选值"| prompt
  prompt -->|"拼上下文并发 QA 请求"| controller
  controller -->|"prediction + 与 reference 比较"| output
  classDef entry fill:#e8f0f3,stroke:#365665,color:#173644
  classDef process fill:#ffffff,stroke:#76828a,color:#20313a
  classDef decision fill:#fff1d9,stroke:#b88733,color:#5d441a
  classDef store fill:#e4efe9,stroke:#54836b,color:#204a36
  classDef model fill:#eeeaf7,stroke:#8371aa,color:#453467
  classDef output fill:#e8f0f3,stroke:#365665,color:#173644
  classDef external fill:#f5f3ef,stroke:#8e897f,color:#49453e
  classDef inferred stroke-dasharray:5 4
  classDef unknown stroke-dasharray:2 4
