---
config:
  layout: elk
---
flowchart TB
  subgraph region_caller["调用方与上下文使用"]
    caller["调用方 agent<br/>消费并产生对话<br/>〔未知〕"]:::external
    class caller unknown
    context["AssembleResult<br/>entries / rendered / digest"]:::output
  end
  subgraph region_native["OpenViking service"]
    api["HTTP / Service API<br/>携带 RequestContext"]:::entry
    resource["ResourceService<br/>解析并导入资源"]:::process
    session["Session.commit_async<br/>归档与保留 live tail"]:::process
    extract["ExtractLoop + updater<br/>提取、合并与应用"]:::process
    semantic["SemanticProcessor<br/>生成目录语义"]:::process
    retrieve["find / search<br/>范围检索与目录展开"]:::process
    assemble["assemble_context<br/>配额、读取与 token 预算"]:::process
    schedulers["Watch / AutoCommit<br/>资源刷新与 idle 提交"]:::process
  end
  subgraph region_durable["持久状态与索引"]
    queue[("QueueFS / workers<br/>持久化异步任务")]:::store
    files[("VikingFS / RAGFS<br/>资源与 memory 文件")]:::store
    summary[(".abstract / .overview<br/>L0 / L1 派生摘要")]:::store
    vector[("VikingDBManager<br/>向量与检索 metadata")]:::store
  end
  subgraph region_models["配置的模型边界"]
    vlm[["VLM / rerank<br/>提取、摘要与重排"]]:::model
    embed[["Embedding model<br/>query / content 向量"]]:::model
  end
  caller -->|"资源、消息、查询与读写请求"| api
  api -->|"add_resource"| resource
  api -->|"commit + retention policy"| session
  resource -->|"解析树持久化"| files
  resource -->|"post-process job"| queue
  session -->|"archive job / task_id"| queue
  queue -->|"恢复并提取 Phase 2"| extract
  extract -->|"schema merge / upsert / delete"| files
  queue -->|"SemanticMsg"| semantic
  files -->|"文件与子目录摘要材料"| semantic
  semantic -->|"生成 L0/L1 与 freshness"| summary
  semantic -->|"embedding jobs"| queue
  queue -->|"内容 embedding"| embed
  embed -->|"向量 + metadata upsert"| vector
  api -->|"query + 范围"| retrieve
  retrieve -->|"tenant / path scope 查询"| vector
  retrieve -->|"候选集合供预算选择"| assemble
  assemble -->|"仅按 tier 读取所需 body"| files
  assemble -->|"entries / rendered / digest"| context
  context -->|"可供 agent 使用的内容"| caller
  extract -->|"带 schema 的提取请求"| vlm
  semantic -->|"overview 生成请求"| vlm
  schedulers -->|"到期 watch refresh"| resource
  schedulers -->|"idle 条件提交"| session
  classDef entry fill:#e8f0f3,stroke:#365665,color:#173644
  classDef process fill:#ffffff,stroke:#76828a,color:#20313a
  classDef decision fill:#fff1d9,stroke:#b88733,color:#5d441a
  classDef store fill:#e4efe9,stroke:#54836b,color:#204a36
  classDef model fill:#eeeaf7,stroke:#8371aa,color:#453467
  classDef output fill:#e8f0f3,stroke:#365665,color:#173644
  classDef external fill:#f5f3ef,stroke:#8e897f,color:#49453e
  classDef inferred stroke-dasharray:5 4
  classDef unknown stroke-dasharray:2 4
