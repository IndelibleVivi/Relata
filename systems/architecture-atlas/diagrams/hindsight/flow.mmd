---
config:
  layout: elk
---
flowchart TB
  subgraph region_app["调用应用／集成"]
    app["调用应用<br/>内容与最终动作<br/>〔未知〕"]:::external
    class app unknown
    integration["LiteLLM callback<br/>可选 context 注入"]:::process
    appmodel[["应用模型<br/>生成后续回复／动作<br/>〔未知〕"]]:::model
    class appmodel unknown
    output["回复／动作结果<br/>应用负责交付<br/>〔未知〕"]:::output
    class output unknown
  end
  subgraph region_api["Hindsight API"]
    api["REST／MemoryEngine<br/>retain · recall · reflect"]:::entry
    auth{"Tenant／validator<br/>schema · bank · tags"}:::decision
    retain["retain pipeline<br/>抽取／embedding／关联"]:::process
    recall["recall<br/>四路检索→融合→预算"]:::process
    reflect["reflect agent<br/>只读 tools 推理"]:::process
  end
  subgraph region_bg["后台执行"]
    worker["Worker poller<br/>claim／execute／retry"]:::process
    consolidator["consolidation<br/>检索旧观察→LLM actions"]:::process
  end
  subgraph region_db["默认 SQL 状态"]
    facts[("documents／memory_units<br/>原文 · facts · links")]:::store
    queue[("async_operations<br/>状态与任务 payload")]:::store
    observations[("observations<br/>来源关联的推断")]:::store
    mentalmodels[("mental_models<br/>显式问题驱动文档")]:::store
  end
  subgraph region_model["模型边界"]
    models[["LLM／embed／rerank<br/>可本地或远端配置"]]:::model
  end
  app -->|"文本／context／date／document_id"| api
  api -->|"tenant schema＋可选 validator"| auth
  auth -->|"async=true 时返回 operation_id"| queue
  queue -->|"claim 已持久任务"| worker
  worker -->|"执行 retain task"| retain
  auth -->|"同步请求等待 retain"| retain
  retain -->|"LLM 抽取→date-augmented embedding"| models
  retain -->|"写原文／chunks／fact／links"| facts
  retain -->|"按配置安排后台 consolidation"| queue
  worker -->|"消费 consolidation job"| consolidator
  facts -->|"新事实＋相同 observation scope"| consolidator
  observations -->|"recall 相关旧观察"| consolidator
  consolidator -->|"验证并提交 create/update/delete"| observations
  app -->|"bank＋query＋tags＋budget"| recall
  facts -->|"semantic/text/graph/temporal 候选"| recall
  observations -->|"可选观察与 source_facts"| recall
  recall -->|"embedding／可选 reranking"| models
  recall -->|"融合／裁剪的结果"| integration
  app -->|"问题＋context＋scope"| reflect
  reflect -->|"iterative tools 检索"| recall
  mentalmodels -->|"lookup/search 当前文档"| reflect
  reflect -->|"证据推理，不写记忆"| models
  reflect -->|"可选以 reflect text 作为 context"| integration
  integration -->|"改写 system／user messages"| appmodel
  appmodel -.->|"生成应用回复或动作"| output
  appmodel -->|"成功调用回调"| integration
  integration -->|"配置允许时 retain 对话"| api
  classDef entry fill:#e8f0f3,stroke:#365665,color:#173644
  classDef process fill:#ffffff,stroke:#76828a,color:#20313a
  classDef decision fill:#fff1d9,stroke:#b88733,color:#5d441a
  classDef store fill:#e4efe9,stroke:#54836b,color:#204a36
  classDef model fill:#eeeaf7,stroke:#8371aa,color:#453467
  classDef output fill:#e8f0f3,stroke:#365665,color:#173644
  classDef external fill:#f5f3ef,stroke:#8e897f,color:#49453e
  classDef inferred stroke-dasharray:5 4
  classDef unknown stroke-dasharray:2 4
