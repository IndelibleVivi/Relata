---
config:
  layout: elk
---
flowchart TB
  subgraph region_client["客户端与管理者"]
    client["Client Harness<br/>三协议／工具循环"]:::entry
    admin["Admin · MCP · REST<br/>管理／显式读写"]:::entry
  end
  subgraph region_worker["Aelios Worker"]
    gateway["handleGateway<br/>认身份与主模型"]:::process
    capture["persistHumanUtterance<br/>先存原话＋显式记住"]:::process
    recall["runRecall · recallPatch<br/>跨空间合并候选"]:::process
    selector["selectRecall<br/>原文窗口重排与规则"]:::process
    patch["appendMemory<br/>临时追加 user 尾部"]:::output
    night["Cron · Dream<br/>每日抽取与整理"]:::process
    judge["Candidate Judge<br/>自动核据与裁决"]:::process
  end
  subgraph region_storage["Cloudflare 存储"]
    raw[("messages · exchanges<br/>原话、结果与状态")]:::store
    memories[("memories · lifecycle<br/>事实、版本、来源")]:::store
    curated[("precious · glossary<br/>珍贵原文与术语")]:::store
    vectors[("Vectorize · FTS<br/>向量／词面候选索引")]:::store
    queue["MEMORY_QUEUE<br/>响应后投递与重试"]:::process
    candidates[("memory_candidates<br/>待审／通过／丢弃")]:::store
    diary[("daily／weekly／monthly<br/>印象摘要阶梯")]:::store
    extensions[("relations · triggers<br/>可选联想索引")]:::store
  end
  subgraph region_models["模型服务边界"]
    upstream["AI Gateway／自定义上游<br/>聊天模型响应"]:::external
    ai[["Workers AI<br/>embedding／rerank／Dream"]]:::model
  end
  client -->|"请求＋显式可见历史"| gateway
  gateway -->|"主模型、人类新输入"| capture
  capture -->|"await 原话与 FTS 保存"| raw
  capture -->|"显式 remember 规则直写"| memories
  admin -->|"memory_upsert 直写"| memories
  memories -->|"正文→embedding／FTS"| vectors
  gateway -->|"最后用户话＋少量 recent"| recall
  vectors -->|"向量／词面混合命中"| recall
  curated -->|"词面术语／相关 precious"| recall
  raw -->|"仅证据问题搜索原话"| recall
  extensions -->|"可选 trigger union／2-hop"| recall
  recall -->|"各空间/来源轮流合并"| selector
  selector -->|"最多 64 个原文窗口打分"| ai
  selector -->|"去重、地板、0–1／0–2"| patch
